# ==============================================================
# web/.gitignore —— 前端（Vue3 + Vite）构建产物与依赖
# 通用规则（OS / IDE / 日志 / .env）见根级 .gitignore，此处不重复。
# ==============================================================

# ---------- 依赖 ----------
node_modules/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz

# ---------- 构建产物 ----------
dist/
dist-ssr/
build/
# 构建验证时临时改名保留的旧产物（如 dist_old_93852156/），按前缀统一忽略
dist_old*/

# ---------- Vite / 构建缓存 ----------
.vite/
node_modules/.vite/
.eslintcache
*.tsbuildinfo

# ---------- 测试与覆盖率 ----------
coverage/
.nyc_output/

# ---------- 本地覆盖文件 ----------
*.local

# ---------- 大体积媒体（防误提交）----------
# 现状：public/assets/video ≈412MB、public/assets/music ≈58.5MB、
# src/assets/music ≈58.5MB（与 public 重复），合计约 529MB 未入库。
# 若误提交将永久撑大仓库历史，故在此显式拦截。
# 后续 C06 资源归并时需一并确定这批媒体的正式管理方案
# （Git LFS / 对象存储 / 部署时注入），届时再调整本节规则。
public/assets/video/
public/assets/music/
src/assets/music/
src/assets/video/
