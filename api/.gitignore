# ==============================================================
# api/.gitignore —— 后端（Python / FastAPI）虚拟环境与缓存
# 通用规则（OS / IDE / 日志 / .env）见根级 .gitignore，此处不重复。
# ==============================================================

# ---------- 虚拟环境 ----------
venv/
.venv/
env/
ENV/

# ---------- 字节码 / 缓存 ----------
__pycache__/
*.py[cod]
*$py.class
*.so

# ---------- 打包产物 ----------
build/
dist/
*.egg-info/
.eggs/

# ---------- 测试与类型检查缓存 ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ---------- 运行时产物 ----------
api.log
*.db
*.sqlite3
