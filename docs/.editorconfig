# 项目统一编辑器配置
# 主流规范：统一缩进与换行，消除因编辑器差异导致的无意义 diff
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{html,htm}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2
